{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axar://events/pricing.outlet.changed/1",
  "title": "pricing.outlet.changed v1 payload",
  "description": "An outlet was pointed at a price list (or back to base prices, price_list_id null). Only approved price versions are ever effective (P1-1a).",
  "type": "object",
  "additionalProperties": false,
  "required": ["location_id", "price_list_id", "changed_by"],
  "properties": {
    "location_id": {"type": "integer", "minimum": 1},
    "price_list_id": {"type": ["integer", "null"], "minimum": 1},
    "changed_by": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}

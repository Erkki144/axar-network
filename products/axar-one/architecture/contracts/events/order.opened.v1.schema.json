{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axar://events/order.opened/1",
  "title": "order.opened v1 payload",
  "description": "Open bill created for a table (orders.open_order).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "table_id",
    "status",
    "version"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "table_id": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "open"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}

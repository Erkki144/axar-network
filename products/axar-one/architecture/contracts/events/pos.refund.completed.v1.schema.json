{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axar://events/pos.refund.completed/1",
  "title": "pos.refund.completed v1 payload (products/axar-pos/axar_pos/services.py:_refund_completed_event)",
  "description": "Positive amounts = money returned to the customer. A refund never modifies the original sale. Currency implicit EUR (gap G-EV-2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["refund_id", "refund_no", "original_sale_id", "original_receipt_no", "original_correlation_id",
               "register_id", "drawer_session_id", "business_date", "payment_method", "simulated", "total_cents",
               "vat_cents", "net_cents", "cash_paid_cents", "cash_rounding_cents", "approver_role", "lines"],
  "properties": {
    "refund_id": {"type": "string", "format": "uuid"},
    "refund_no": {"type": "integer", "minimum": 1},
    "original_sale_id": {"type": "string", "format": "uuid"},
    "original_receipt_no": {"type": "integer", "minimum": 1},
    "original_correlation_id": {"type": "string", "format": "uuid"},
    "register_id": {"type": "integer", "minimum": 1},
    "drawer_session_id": {"type": "integer", "minimum": 1},
    "business_date": {"type": "string", "format": "date"},
    "payment_method": {"const": "cash"},
    "simulated": {"const": true},
    "total_cents": {"type": "integer", "minimum": 0},
    "vat_cents": {"type": "integer", "minimum": 0},
    "net_cents": {"type": "integer", "minimum": 0},
    "cash_paid_cents": {"type": "integer", "minimum": 0},
    "cash_rounding_cents": {"type": "integer", "minimum": -4, "maximum": 4},
    "approver_role": {"enum": ["manager", "owner"]},
    "lines": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sku", "quantity", "gross_cents", "vat_rate_bp", "vat_cents"],
        "properties": {
          "sku": {"type": "string", "minLength": 1, "maxLength": 64},
          "quantity": {"type": "integer", "minimum": 1, "maximum": 999},
          "gross_cents": {"type": "integer", "minimum": 0},
          "vat_rate_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
          "vat_cents": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}

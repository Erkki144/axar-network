{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axar://events/pos.sale.completed/1",
  "title": "pos.sale.completed v1 payload (as emitted by products/axar-pos/axar_pos/services.py:_sale_completed_event)",
  "description": "Canonical JSON (sorted keys, no spaces) stored in outbox_events.payload; payload_hash = sha256(payload). Amounts are integer euro cents. Currency is implicit EUR in v1 (gap G-EV-2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["sale_id", "receipt_no", "register_id", "drawer_session_id", "business_date", "payment_method",
               "total_cents", "vat_cents", "net_cents", "cash_due_cents", "cash_rounding_cents", "lines"],
  "properties": {
    "sale_id": {"type": "string", "format": "uuid"},
    "receipt_no": {"type": "integer", "minimum": 1},
    "register_id": {"type": "integer", "minimum": 1},
    "drawer_session_id": {"type": "integer", "minimum": 1},
    "business_date": {"type": "string", "format": "date"},
    "payment_method": {"const": "cash"},
    "total_cents": {"type": "integer", "minimum": 0},
    "vat_cents": {"type": "integer", "minimum": 0},
    "net_cents": {"type": "integer", "minimum": 0},
    "cash_due_cents": {"type": "integer", "minimum": 0},
    "cash_rounding_cents": {"type": "integer", "minimum": -2, "maximum": 2},
    "lines": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sku", "quantity", "unit_price_cents", "gross_cents", "vat_rate_bp", "vat_cents"],
        "properties": {
          "sku": {"type": "string", "minLength": 1, "maxLength": 64},
          "quantity": {"type": "integer", "minimum": 1, "maximum": 999},
          "unit_price_cents": {"type": "integer", "minimum": 0},
          "gross_cents": {"type": "integer", "minimum": 0},
          "vat_rate_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
          "vat_cents": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
